{
  "name": "etrade-trade-placer",
  "version": "1.0.0",
  "description": "Automated daily trading application with E*TRADE integration",
  "main": "dist/server/index.js",
  "type": "module",
  "scripts": {
    "predev": "pg_isready -q || /usr/local/opt/postgresql@14/bin/pg_ctl -D /usr/local/var/postgresql@14 start",
    "prescheduler:local": "pg_isready -q || /usr/local/opt/postgresql@14/bin/pg_ctl -D /usr/local/var/postgresql@14 -l /tmp/pg14.log start",
    "dev": "concurrently \"npm run server:dev\" \"npm run client:dev\"",
    "server:dev": "tsx watch src/server/index.ts",
    "client:dev": "vite",
    "build": "npm run build:server && npm run build:client",
    "build:server": "tsc -p tsconfig.server.json",
    "build:client": "vite build",
    "start": "node dist/server/index.js",
    "scheduler:local": "tsx src/scheduler/local-scheduler.ts",
    "db:migrate": "tsx src/server/database/migrate.ts",
    "oauth": "tsx src/scripts/oauth-flow.ts",
    "execute:xom-test-order": "tsx src/scripts/execute-xom-order.ts",
    "execute:wulf-test-order": "tsx src/scripts/execute-wulf-order.ts",
    "connection-test": "tsx src/scripts/get-micron-quote.ts",
    "slv-overnight": "tsx src/scripts/send-slv-overnight-order.ts",
    "test-overnight-session": "tsx src/scripts/test-overnight-market-session.ts",
    "web:overnight-preview-place": "tsx src/scripts/webapitrd-overnight-preview-and-place.ts",
    "silver-price-order": "tsx src/scripts/silver-price-order.ts",
    "sezl:short:caffeinated": "caffeinate -s -i tsx src/scripts/sezl-short-caffeinated.ts",
    "sezl:short:caffeinated:sleep": "caffeinate -s -i tsx src/scripts/sezl-short-caffeinated.ts; h=$(date +%H); h=$((h+0)); [ $h -ge 20 ] && pmset sleepnow",
    "pg:start": "/usr/local/opt/postgresql@14/bin/pg_ctl -D /usr/local/var/postgresql@14 -l /tmp/pg14.log start",
    "pg:stop": "/usr/local/opt/postgresql@14/bin/pg_ctl -D /usr/local/var/postgresql@14 stop",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "keywords": [
    "trading",
    "etrade",
    "automation",
    "scheduler"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@tailwindcss/postcss": "^4.1.18",
    "axios": "^1.13.2",
    "cors": "^2.8.5",
    "date-fns": "^4.1.0",
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "ioredis": "^5.9.2",
    "node-cron": "^4.2.1",
    "oauth-1.0a": "^2.2.6",
    "pg": "^8.17.2",
    "puppeteer": "^24.36.0",
    "uuid": "^13.0.0",
    "ws": "^8.19.0",
    "zod": "^4.3.5"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^25.0.9",
    "@types/pg": "^8.16.0",
    "@types/react": "^19.2.9",
    "@types/react-dom": "^19.2.3",
    "@types/uuid": "^10.0.0",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^5.1.2",
    "autoprefixer": "^10.4.23",
    "concurrently": "^9.2.1",
    "postcss": "^8.5.6",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "tailwindcss": "^4.1.18",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.1"
  }
}
